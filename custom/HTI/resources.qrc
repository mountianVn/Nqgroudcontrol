<RCC>
    <!-- HTI UI Components -->
    <qresource prefix="/qml/HTI">
        <file alias="HTITestPanel.qml">qml/HTITestPanel.qml</file>
        <file alias="HTIInfoPill.qml">qml/HTIInfoPill.qml</file>
          <file alias="HTIAltitudeGauge.qml">qml/HTIAltitudeGauge.qml</file>
          <file alias="HTISpeedGauge.qml">qml/HTISpeedGauge.qml</file>
          <file alias="HTISpeedAltitudeGauge.qml">qml/HTISpeedAltitudeGauge.qml</file>
        <file alias="HTIAttitudeGauge.qml">qml/HTIAttitudeGauge.qml</file>
        <file alias="HTIHeadingGauge.qml">qml/HTIHeadingGauge.qml</file>
        <file alias="HTIBottomRightHud.qml">qml/HTIBottomRightHud.qml</file>
        <file alias="HTIHeroButton.qml">qml/HTIHeroButton.qml</file>
        <file alias="HTIModernButton.qml">qml/HTIModernButton.qml</file>
        <file alias="HTIActionButton.qml">qml/HTIActionButton.qml</file>
        <file alias="HTIPanelTabButton.qml">qml/HTIPanelTabButton.qml</file>
        <file alias="HTIStatusRow.qml">qml/HTIStatusRow.qml</file>
        <file alias="HTIFunctionsPanel.qml">qml/HTIFunctionsPanel.qml</file>
        <file alias="HTIMissionPanel.qml">qml/HTIMissionPanel.qml</file>
        <file alias="HTIRightControlPanel.qml">qml/HTIRightControlPanel.qml</file>
        <file alias="HTIMavlinkActionsPanel.qml">qml/HTIMavlinkActionsPanel.qml</file>
        <file alias="HTILeftToolBar.qml">qml/HTILeftToolBar.qml</file>
        <file alias="HTILeftToolButton.qml">qml/HTILeftToolButton.qml</file>
        <file alias="HTIConnectionDialog.qml">qml/HTIConnectionDialog.qml</file>
        <file alias="HTIVoiceSettings.qml">qml/HTIVoiceSettings.qml</file>
        <file alias="Speed_Alt_440x220.png">../../resources/Speed_Alt_440x220.png</file>
    </qresource>

    <!-- Custom Override QML (intercepted by CustomOverrideInterceptor) -->
    <qresource prefix="/Custom/qml">
        <file alias="QGroundControl/MainWindow.qml">qml/QGroundControl/MainWindow.qml</file>
        <file alias="QGroundControl/FlyView/FlyViewCustomLayer.qml">qml/FlyViewCustomLayer.qml</file>
        <file alias="QGroundControl/FlyView/FlyViewBottomRightRowLayout.qml">qml/QGroundControl/FlyView/FlyViewBottomRightRowLayout.qml</file>
        <file alias="QGroundControl/FlyView/FlyViewTopRightColumnLayout.qml">qml/QGroundControl/FlyView/FlyViewTopRightColumnLayout.qml</file>
        <file alias="QGroundControl/Controls/AppSettings.qml">qml/QGroundControl/Controls/AppSettings.qml</file>
    </qresource>

    <!-- Reserved for HTI logos, icons, splash screens and vehicle assets. -->
    <qresource prefix="/HTI">
    </qresource>
</RCC>
